{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "tests/**"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**/*.md",
          "constitution.md",
          "README.md"
        ],
        "exclude": [
          "**/obj/**",
          "**/bin/**"
        ]
      },
      {
        "files": [
          "docs/web/toc.yml",
          "docs/web/index.md",
          "docs/web/articles/**.md",
          "docs/web/articles/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "Network Monitoring System",
      "_appFooter": "© 2026 Network Monitoring Project. Full compliance with Constitution v1.6.0.",
      "_enableSearch": true
    }
  }
}
