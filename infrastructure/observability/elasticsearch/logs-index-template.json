{
  "index_patterns": [
    "observability-logs-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "service.name": {
          "type": "keyword"
        },
        "service.namespace": {
          "type": "keyword"
        },
        "service.type": {
          "type": "keyword"
        },
        "container.id": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "severity_text": {
          "type": "keyword"
        },
        "correlationId": {
          "type": "keyword"
        },
        "traceId": {
          "type": "keyword"
        },
        "body": {
          "type": "text"
        }
      }
    }
  },
  "_meta": {
    "description": "Index template for observability structured logs from authored services and platform components. `service.type` separates the two origins, and `tags` carries normalization failures so unparsed records stay queryable rather than being discarded."
  }
}
