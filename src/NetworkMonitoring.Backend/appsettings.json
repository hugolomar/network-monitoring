{
  "Backend": {
    "ConnectionString": "Host=localhost;Port=5432;Database=network_monitoring;Username=network_monitoring;Password=network_monitoring",
    "ApplyMigrationsOnStartup": true,
    "Graph": {
      "DefaultDepth": 1,
      "MaxDepth": 3,
      "DefaultLimit": 200,
      "MaxLimit": 500,
      "RetentionWindowDays": 90,
      "RetentionCadenceHours": 24,
      "ProjectionMaxRetries": 3,
      "ProjectionRetryBaseDelayMs": 200,
      "ProjectionAttemptTimeoutMs": 2000,
      "EnableStructuredLogs": true,
      "EnableMetrics": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
