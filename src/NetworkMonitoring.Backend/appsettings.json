{
  "Backend": {
    "ConnectionString": "Host=localhost;Port=5432;Database=network_monitoring;Username=network_monitoring;Password=network_monitoring",
    "ApplyMigrationsOnStartup": true,
    "Graph": {
      "Provider": "Neo4j",
      "Neo4jUri": "bolt://localhost:7687",
      "Neo4jUsername": "neo4j",
      "Neo4jPassword": "networkmonitoring123",
      "DefaultDepth": 1,
      "MaxDepth": 3,
      "DefaultLimit": 200,
      "MaxLimit": 500,
      "RetentionWindowDays": 90,
      "RetentionCadenceHours": 24,
      "ProjectionMaxRetries": 3,
      "ProjectionRetryBaseDelayMs": 200,
      "ProjectionAttemptTimeoutMs": 2000,
      "EnableStructuredLogs": true,
      "EnableMetrics": true
    }
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "EnableStructuredLogging": true,
    "EnableConsoleLogging": true,
    "EnableOtlpLogs": true,
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
