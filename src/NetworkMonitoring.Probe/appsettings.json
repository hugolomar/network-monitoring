{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Probe": {
    "InputMode": "Live",
    "TSharkPath": "tshark",
    "InterfaceName": "eth0",
    "DeterministicTestPcapPath": "",
    "CaptureFilter": "",
    "SessionDeduplicationWindowMinutes": 10,
    "DeviceDeduplicationWindowMinutes": 10,
    "EnableConsole": false,
    "EnableKafka": true,
    "KafkaBootstrapServers": "localhost:9092,localhost:9093,localhost:9094",
    "SchemaRegistryUrl": "http://localhost:8081",
    "KafkaSessionTopic": "sessions.detected",
    "KafkaDeviceTopic": "devices.detected",
    "KafkaSecurityProtocol": "Plaintext"
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "EnableStructuredLogging": true,
    "EnableConsoleLogging": true,
    "EnableOtlpLogs": true,
    "OtlpEndpoint": "http://localhost:4317"
  }
}
